[Unit]
Description=GitHub Repository Downloader Telegram Bot
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/path/to/github-repo-bot
Environment="PATH=/path/to/github-repo-bot/venv/bin"
ExecStart=/path/to/github-repo-bot/venv/bin/python bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
